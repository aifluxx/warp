# Copy to deploy/vps/.env and edit there. Do not commit .env.
# This file has placeholders only. It is not a secret store.

COMPOSE_PROJECT_NAME=warp-oss

# Host port bound on 127.0.0.1 only. Chosen so it does not sit on the usual
# aifluxx web and database ports (80, 443, 3000, 5173, 5432, 6379, 8000, 8080).
WARP_TUI_PORT=8791

# Port inside the container. Leave this at 7681 unless ttyd's listen port changes.
TTYD_PORT=7681

# Optional Warp user API key for app.warp.dev. Leave blank to open the TUI's
# login screen instead. This does not create a Warp backend.
WARP_API_KEY=

# Optional HTTP basic auth for the web terminal. Leave both blank to disable.
# Use a long random password if you set these. Do not reuse an account password.
TTYD_USERNAME=
TTYD_PASSWORD=

# Cargo profile used while building the image.
# release-tui is the supported headless profile (thin LTO, smaller binary).
# dev compiles with less link-time memory if a build is killed by the OOM killer.
WARP_CARGO_PROFILE=release-tui

# Parallel rustc jobs during the image build. Lower this on a busy host.
CARGO_BUILD_JOBS=2

# Runtime cap for the single container. Keep this modest next to aifluxx.
WARP_TUI_MEM_LIMIT=1g
WARP_TUI_CPUS=1.0
