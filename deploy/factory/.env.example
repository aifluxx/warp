# AIFluxx company factory slice. Not Warp Factories.
# Leave secrets empty. Do not commit a filled copy.
# The process listens on loopback until you choose a different FACTORY_BIND.

FACTORY_BIND=127.0.0.1:8792
FACTORY_PUBLIC_URL=http://127.0.0.1:8792
FACTORY_SESSION_SECRET=
FACTORY_COOKIE_SECURE=0
FACTORY_REPO_ID=warp
FACTORY_REPO_ROOT=

# Company identity provider. Both are required before sign-in can succeed.
# OIDC_CLIENT_SECRET is required when that provider uses a confidential client.
# The provider must issue RS256 ID tokens. No provider is bundled.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
