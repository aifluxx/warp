# AIFluxx company factory. Not Warp Factories. Not the headless terminal.
# Copy to deploy/factory/.env on the host that runs it. Never commit the copy.
# Leave every secret empty in git.

# The process refuses any other address. Compose uses the host network so
# this is the VPS loopback. Do not publish port 8792.
FACTORY_BIND=127.0.0.1:8792
FACTORY_PUBLIC_URL=https://factory.aifluxx.co.za
FACTORY_SESSION_SECRET=
FACTORY_COOKIE_SECURE=1
FACTORY_REPO_ID=warp
FACTORY_REPO_ROOT=/srv/factory-repo

# New Google web client only. Do not copy an existing production client id
# and do not add these redirect URIs to an existing client.
OIDC_ISSUER=https://accounts.google.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Workspace hosted domain in the ID token. This is not the public site name.
FACTORY_ALLOWED_DOMAIN=aifluxx.com
