# AIFluxx company factory. Not Warp Factories. Not the headless terminal.
# Copy to deploy/factory/.env on the host that runs it. Never commit the copy.
# Leave every secret empty in git.

# Inside the container the process listens on all interfaces.
# The compose file publishes that port only on the VPS loopback.
FACTORY_BIND=0.0.0.0:8792
FACTORY_PUBLIC_URL=https://factory.aifluxx.co.za
FACTORY_SESSION_SECRET=
FACTORY_COOKIE_SECURE=1
FACTORY_REPO_ID=warp
FACTORY_REPO_ROOT=/srv/factory-repo

# Google Workspace. Do not use a Warp API key.
# Create the OAuth client in the company's existing Google Cloud project.
# Do not change any other SSO client.
OIDC_ISSUER=https://accounts.google.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Hosted domain required in the ID token. Personal Gmail accounts have none.
FACTORY_ALLOWED_DOMAIN=aifluxx.co.za
